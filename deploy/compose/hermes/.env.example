# Shared secret between mneme and Hermes. Generate one with:
#   openssl rand -base64 32
MNEME_HTTP_TOKEN=

# Host directory mounted as Hermes' /opt/data (its HERMES_HOME).
# Point it at an existing ~/.hermes to reuse a bare-metal install.
HERMES_DATA=./hermes-data

# Host user that should own Hermes' files (see Hermes' Docker docs).
HERMES_UID=10000
HERMES_GID=10000

# Image overrides.
# MNEME_IMAGE=mneme:local
# HERMES_IMAGE=nousresearch/hermes-agent:latest
